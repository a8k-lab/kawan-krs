generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  MAHASISWA
  DOSEN
  ADMIN
  SUPERADMIN
}

// ==========================================
// 1. MODUL AKADEMIK (acad_)
// ==========================================

// Master Fakultas
model AcadFaculty {
  id          Int                 @id @default(autoincrement())
  uuid        String              @unique @default(uuid()) @db.Uuid
  code        String              @unique @db.VarChar(50) // e.g. "FIF"
  name        String              @db.VarChar(150)        // e.g. "Fakultas Informatika"
  description String?             @db.Text

  // Audit Trail & Lifecycle
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   BigInt              @default(dbgenerated("(EXTRACT(epoch FROM now()))::bigint")) @map("created_at")
  updatedAt   BigInt              @default(dbgenerated("(EXTRACT(epoch FROM now()))::bigint")) @map("updated_at")
  deletedAt   BigInt?             @map("deleted_at")
  createdBy   Int?                @map("created_by")
  updatedBy   Int?                @map("updated_by")
  deletedBy   Int?                @map("deleted_by")
  version     Int                 @default(1) @map("version")

  // Relasi
  studyPrograms AcadStudyProgram[]
  userDetails   AuthUserDetail[]

  @@map("acad_faculties")
}

// Master Program Studi (Memiliki relasi ke Fakultas)
model AcadStudyProgram {
  id          Int                 @id @default(autoincrement())
  uuid        String              @unique @default(uuid()) @db.Uuid
  facultyId   Int                 @map("faculty_id")
  code        String              @unique @db.VarChar(50) // e.g. "PJJ-IF"
  name        String              @db.VarChar(150)        // e.g. "S1 PJJ Informatika"
  degree      String?             @db.VarChar(20)         // e.g. "S1"

  // Audit Trail & Lifecycle
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   BigInt              @default(dbgenerated("(EXTRACT(epoch FROM now()))::bigint")) @map("created_at")
  updatedAt   BigInt              @default(dbgenerated("(EXTRACT(epoch FROM now()))::bigint")) @map("updated_at")
  deletedAt   BigInt?             @map("deleted_at")
  createdBy   Int?                @map("created_by")
  updatedBy   Int?                @map("updated_by")
  deletedBy   Int?                @map("deleted_by")
  version     Int                 @default(1) @map("version")

  // Relasi
  faculty     AcadFaculty         @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  userDetails AuthUserDetail[]

  @@map("acad_study_programs")
}

// ==========================================
// 2. MODUL AUTENTIKASI & PENGGUNA (auth_)
// ==========================================

// auth_users: Kredensial Otentikasi Utama
model AuthUser {
  id           Int              @id @default(autoincrement())
  uuid         String           @unique @default(uuid()) @db.Uuid
  email        String           @unique @db.VarChar(255)
  password     String           @map("password") @db.VarChar(255)
  
  // Audit Trail & Lifecycle
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    BigInt           @default(dbgenerated("(EXTRACT(epoch FROM now()))::bigint")) @map("created_at")
  updatedAt    BigInt           @default(dbgenerated("(EXTRACT(epoch FROM now()))::bigint")) @map("updated_at")
  deletedAt    BigInt?          @map("deleted_at")
  createdBy    Int?             @map("created_by")
  updatedBy    Int?             @map("updated_by")
  deletedBy    Int?             @map("deleted_by")
  version      Int              @default(1) @map("version")

  // Relasi
  detail       AuthUserDetail?
  sessions     AuthUserSession[]

  // Relasi Dosen PA ke mahasiswa bimbingan
  advisees     AuthUserDetail[] @relation("AdvisorRelation")

  @@map("auth_users")
}

// auth_roles: Master Peran
model AuthRole {
  id          Int              @id @default(autoincrement())
  uuid        String           @unique @default(uuid()) @db.Uuid
  code        RoleCode         @unique
  name        String           @db.VarChar(100)
  description String?          @db.Text
  
  // Audit Trail & Lifecycle
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   BigInt           @default(dbgenerated("(EXTRACT(epoch FROM now()))::bigint")) @map("created_at")
  updatedAt   BigInt           @default(dbgenerated("(EXTRACT(epoch FROM now()))::bigint")) @map("updated_at")
  deletedAt   BigInt?          @map("deleted_at")
  createdBy   Int?             @map("created_by")
  updatedBy   Int?             @map("updated_by")
  deletedBy   Int?             @map("deleted_by")
  version     Int              @default(1) @map("version")

  users       AuthUserDetail[]

  @@map("auth_roles")
}

// auth_user_details: Seluruh Informasi Civitas Akademika
model AuthUserDetail {
  id             Int               @id @default(autoincrement())
  uuid           String            @unique @default(uuid()) @db.Uuid
  userId         Int               @unique @map("user_id")
  roleId         Int               @map("role_id")
  
  // Identifier menampung NIM (Mahasiswa), NIP (Dosen), atau ID Pegawai (Admin)
  identifier     String            @unique @db.VarChar(50)
  fullName       String            @map("full_name") @db.VarChar(150)

  // Relasi ke Master Fakultas & Program Studi
  facultyId      Int?              @map("faculty_id")
  studyProgramId Int?              @map("study_program_id")
  
  // Atribut spesifik Mahasiswa (NULL untuk Dosen/Admin)
  cohort         String?           @db.VarChar(4) // Tahun Angkatan Masuk Mahasiswa, e.g. "2024"
  gpa            Decimal?          @db.Decimal(3, 2) // IPK, e.g. 3.82
  totalCredits   Int?              @default(0) @map("total_credits") // SKS Lulus, e.g. 114
  advisorId      Int?              @map("advisor_id") // Relasi ke auth_users(id) Dosen PA
  
  // Atribut spesifik Dosen (NULL untuk Mahasiswa)
  title          String?           @db.VarChar(100) // Gelar Akademik, e.g. "Prof. Dr. Ir."

  // Profil umum
  avatarUrl      String?           @map("avatar_url") @db.VarChar(255)
  phoneNumber    String?           @map("phone_number") @db.VarChar(20)

  // Audit Trail & Lifecycle
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      BigInt            @default(dbgenerated("(EXTRACT(epoch FROM now()))::bigint")) @map("created_at")
  updatedAt      BigInt            @default(dbgenerated("(EXTRACT(epoch FROM now()))::bigint")) @map("updated_at")
  deletedAt      BigInt?           @map("deleted_at")
  createdBy      Int?              @map("created_by")
  updatedBy      Int?              @map("updated_by")
  deletedBy      Int?              @map("deleted_by")
  version        Int               @default(1) @map("version")

  // Relasi
  user           AuthUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           AuthRole          @relation(fields: [roleId], references: [id])
  advisor        AuthUser?         @relation("AdvisorRelation", fields: [advisorId], references: [id])
  faculty        AcadFaculty?      @relation(fields: [facultyId], references: [id])
  studyProgram   AcadStudyProgram? @relation(fields: [studyProgramId], references: [id])

  @@map("auth_user_details")
}

// auth_user_sessions: Sesi Login & Manajemen Refresh Token
model AuthUserSession {
  id               Int          @id @default(autoincrement())
  uuid             String       @unique @default(uuid()) @db.Uuid
  userId           Int          @map("user_id")
  refreshTokenHash String       @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?      @map("user_agent") @db.Text
  ipAddress        String?      @map("ip_address") @db.VarChar(45)
  isRevoked        Boolean      @default(false) @map("is_revoked")
  expiresAt        BigInt       @map("expires_at") // Epoch expired timestamp

  // Audit Trail & Lifecycle
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        BigInt       @default(dbgenerated("(EXTRACT(epoch FROM now()))::bigint")) @map("created_at")
  updatedAt        BigInt       @default(dbgenerated("(EXTRACT(epoch FROM now()))::bigint")) @map("updated_at")
  deletedAt        BigInt?      @map("deleted_at")
  createdBy        Int?         @map("created_by")
  updatedBy        Int?         @map("updated_by")
  deletedBy        Int?         @map("deleted_by")
  version          Int          @default(1) @map("version")

  user             AuthUser     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_user_sessions")
}
