{
  "name": "kawan-krs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter @kawan-krs/api dev",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter @kawan-krs/api build",
    "studio": "pnpm --filter @kawan-krs/api exec prisma studio",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.86.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
